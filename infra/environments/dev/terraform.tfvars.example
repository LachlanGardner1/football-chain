project            = "football-chain"
environment        = "dev"
aws_region         = "ap-southeast-2"

lambda_memory_size = 512
lambda_timeout     = 30

# Get this from neon.tech - create a free project, then copy the *pooled* connection string
# (not the direct one - see the setup steps in main.tf for why). Never commit the real value;
# this file is the .example, the real terraform.tfvars is gitignored (**/terraform.tfvars in
# the repo root .gitignore already covers it).
neon_database_url  = "postgresql://user:password@ep-example-pooler.ap-southeast-2.aws.neon.tech/football_chain?sslmode=require"

log_retention_days = 14
alarm_email        = ""
