{
  "name": "football-chain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/cleanup-dev-ports.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx --tsconfig scripts/tsconfig.json scripts/migrate.ts",
    "db:seed": "tsx --tsconfig scripts/tsconfig.json scripts/seed-dev.ts",
    "db:reset-dev": "npm run db:migrate && npm run db:seed",
    "test:validation": "node --test --import tsx src/backend/services/game/chain-validation.service.test.ts"
  },
  "dependencies": {
    "next": "^15.3.3",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.17",
    "tsx": "^4.19.1",
    "typescript": "^5.7.2"
  }
}
